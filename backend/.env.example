# Porta em que o servidor vai rodar
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Segredo usado para assinar os tokens de login do admin.
# IMPORTANTE: troque por uma string longa e aleatória antes de colocar em produção.
# Dica: gere uma com o comando  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-uma-string-secreta-bem-longa-e-aleatoria
JWT_EXPIRES_IN=8h

# Credenciais do administrador criadas automaticamente no primeiro "npm run seed".
# Depois do primeiro login, a senha pode (e deve) ser trocada dentro do próprio painel admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=flordeacucar2026

# Endereço(s) do front-end que podem acessar a API (separados por vírgula).
# Em desenvolvimento local, o próprio servidor já serve o front-end, então localhost basta.
CORS_ORIGIN=http://localhost:3000
